rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Session document — readable/writable by authenticated users whose token
    // carries a `sessionId` claim matching the document path.
    match /sessions/{sessionId} {
      allow read, write: if request.auth != null
                         && request.auth.token.sessionId == sessionId;

      // Subcollections: state, inbox, outbox
      match /state/{docId} {
        allow read, write: if request.auth != null
                           && request.auth.token.sessionId == sessionId;
      }

      match /inbox/{docId} {
        allow read, write: if request.auth != null
                           && request.auth.token.sessionId == sessionId;
      }

      match /outbox/{docId} {
        allow read, write: if request.auth != null
                           && request.auth.token.sessionId == sessionId;
      }
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
